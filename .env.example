# TasteGraph API configuration (see tastebench/tastegraph/server.py).
# Copy to .env and adjust. All are optional; unset values fall back to safe defaults.

# Auth: JSON map of api-key -> tenant id. Unset = single-tenant dev mode (no key required).
# TASTEGRAPH_API_KEYS={"key_a":"tenant_a","key_b":"tenant_b"}

# Vector backend: "memory" (default, in-process) or "qdrant".
TASTEGRAPH_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# Rate limiting / quotas (per api-key). 0 or unset = unlimited.
TASTEGRAPH_RATE_PER_MIN=120
# TASTEGRAPH_RATE_BURST=120
TASTEGRAPH_QUOTA_PER_DAY=100000

# LLM for /ask and /explain (optional; templated fallback when unset).
# TASTEGRAPH_ASK_MODEL=gpt-4o
# TASTEGRAPH_EXPLAIN_MODEL=gpt-4o

PORT=8000
