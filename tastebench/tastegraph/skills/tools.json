{
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "taste_context",
        "description": "Structured taste read for a user subject (principles, avoid, confidence, top assets). GET /agent-context/{user_id}",
        "parameters": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string", "description": "Audience / user subject id" }
          },
          "required": ["user_id"]
        },
        "x-tastegraph": { "method": "GET", "path": "/agent-context/{user_id}" }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "taste_search",
        "description": "Discover content by a user's taste. POST /v1/search",
        "parameters": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string" },
            "k": { "type": "integer", "default": 8 }
          },
          "required": ["user_id"]
        },
        "x-tastegraph": { "method": "POST", "path": "/v1/search" }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "taste_rerank",
        "description": "Reorder candidate content ids by a user's taste. POST /v1/rerank",
        "parameters": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string" },
            "candidates": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["user_id", "candidates"]
        },
        "x-tastegraph": { "method": "POST", "path": "/v1/rerank" }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "taste_ask",
        "description": "Taste-personalized Q&A for a user. POST /v1/ask",
        "parameters": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string" },
            "question": { "type": "string" },
            "k": { "type": "integer", "default": 5 }
          },
          "required": ["user_id", "question"]
        },
        "x-tastegraph": { "method": "POST", "path": "/v1/ask" }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "taste_explain",
        "description": "Natural-language explanation of a user's taste. POST /v1/explain",
        "parameters": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string" }
          },
          "required": ["user_id"]
        },
        "x-tastegraph": { "method": "POST", "path": "/v1/explain" }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "taste_metrics",
        "description": "Customer-intelligence metrics for the tenant graph. GET /metrics",
        "parameters": {
          "type": "object",
          "properties": {}
        },
        "x-tastegraph": { "method": "GET", "path": "/metrics" }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "taste_brand_ingest",
        "description": "Create/update a brand or voice subject from reference texts and link them as taste. POST /v1/brand/ingest",
        "parameters": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "type": { "type": "string", "enum": ["brand", "voice"], "default": "brand" },
            "label": { "type": "string" },
            "references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "content": { "type": "string" }
                },
                "required": ["content"]
              }
            }
          },
          "required": ["id", "references"]
        },
        "x-tastegraph": { "method": "POST", "path": "/v1/brand/ingest" }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "taste_enhance",
        "description": "Rewrite a prompt/draft to match a user or brand/voice subject's taste. POST /v1/enhance",
        "parameters": {
          "type": "object",
          "properties": {
            "subject_id": { "type": "string" },
            "prompt": { "type": "string" }
          },
          "required": ["subject_id", "prompt"]
        },
        "x-tastegraph": { "method": "POST", "path": "/v1/enhance" }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "taste_judge",
        "description": "Score draft candidates against a user or brand/voice subject's taste. POST /v1/judge",
        "parameters": {
          "type": "object",
          "properties": {
            "subject_id": { "type": "string" },
            "candidates": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["subject_id", "candidates"]
        },
        "x-tastegraph": { "method": "POST", "path": "/v1/judge" }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "taste_export_pairs",
        "description": "Export preference pairs derived from accumulated signals (training data). GET /v1/export/pairs",
        "parameters": {
          "type": "object",
          "properties": {
            "format": { "type": "string", "enum": ["json", "jsonl"] }
          },
          "required": []
        },
        "x-tastegraph": { "method": "GET", "path": "/v1/export/pairs" }
      }
    }
  ]
}
